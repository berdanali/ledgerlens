# PostgreSQL OLTP source
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=changeme

# Convenience DSN — seed_generator.py uses this first if set
# DATABASE_URL=postgresql://ledgerlens:changeme@localhost:5432/ledgerlens

# Seed generator overrides (optional)
SEED_N_CUSTOMERS=500
SEED_SUSPICIOUS_RATIO=0.03

# MinIO (S3-compatible landing zone)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=ledgerlens-landing

# Landing zone consumer
# MINIO_ENDPOINT_URL is only needed when running the consumer outside Docker
MINIO_ENDPOINT_URL=http://localhost:9000
# PSEUDONYM_SALT must be a long random string — never commit the real value
PSEUDONYM_SALT=change-me-to-a-long-random-secret
FLUSH_INTERVAL_SECONDS=60
FLUSH_MAX_MESSAGES=5000

# Airflow
# Generate fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme-generate-with-command-above
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
